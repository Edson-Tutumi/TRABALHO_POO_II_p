                    </children>
                </HBox>
                <HBox prefHeight="55.0" prefWidth="298.0">
                    <children>
                        <Label fx:id="lblIdAtaque" alignment="TOP_LEFT" text="ID do Ataque:  ">
                            <padding><Insets bottom="10.0" left="10.0" top="10.0" /></padding>
                        </Label>
                        <TextField fx:id="txtIdAtaque" prefHeight="38.0" prefWidth="187.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <Label fx:id="lblInserirPokemon" layoutX="110.0" layoutY="25.0" text="Cadastrar com Ataque">
            <font><Font size="32.0" /></font>
        </Label>
        <Button fx:id="btnInserirPokemon" layoutX="295.0" layoutY="350.0" mnemonicParsing="false" onAction="#btnInserirComAtaque" text="Cadastrar e Vincular" />
        <Button layoutX="139.0" layoutY="350.0" mnemonicParsing="false" onAction="#btnVoltarOnAction" text="Voltar ao menu" />
    </children>
