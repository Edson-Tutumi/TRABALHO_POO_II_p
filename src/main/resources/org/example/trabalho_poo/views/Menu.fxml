<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">
   <children>
      <Label layoutX="111.0" layoutY="23.0" text="Pokemon Pokedex Creator">
         <font>
            <Font size="32.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" layoutX="33.0" layoutY="116.0" prefWidth="250.0" spacing="10.0">
         <children>
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAdicionarPokemonOnAction" text="Adicionar pokemon" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAtualizarPokemonOnAction" text="Atualizar pokemon" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnPesquisarPokemonOnAction" text="Pesquisar pokemon" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnDeletarPokemonOnAction" text="Deletar pokemon" />
         </children>
      </VBox>
      <VBox alignment="CENTER" layoutX="323.0" layoutY="116.0" prefWidth="250.0" spacing="10.0">
         <children>
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAdicionarAtaquesOnAction" text="Adicionar ataque" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAtualizarAtaquesOnAction" text="Atualizar ataque" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnPesquisarAtaquesOnAction" text="Pesquisar ataque" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnDeletarAtaquesOnAction" text="Deletar ataque" />
         </children>
      </VBox>
      <VBox alignment="CENTER" layoutX="174.0" layoutY="303.0" prefWidth="250.0" spacing="10.0">
         <children>
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnPokemonAttackOnAction" text="Vincular ataques" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#btnTypeChartOnAction" text="Tabela de tipos" />
         </children>
      </VBox>
   </children>
</AnchorPane>
