<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Delete.DeleteAttackController">
    <children>
        <Label layoutX="160.0" layoutY="35.0" text="Deletar ataque">
            <font><Font size="40.0" /></font>
        </Label>
        <HBox layoutX="110.0" layoutY="160.0" prefHeight="55.0" prefWidth="380.0">
            <children>
                <Label text="ID do ataque:  ">
                    <padding><Insets bottom="10.0" left="10.0" top="10.0" /></padding>
                </Label>
                <TextField fx:id="txtIdAtaque" prefHeight="38.0" prefWidth="220.0" />
            </children>
        </HBox>
        <Button layoutX="320.0" layoutY="280.0" mnemonicParsing="false" onAction="#btnDeletarOnAction" text="Excluir" />
        <Button layoutX="150.0" layoutY="280.0" mnemonicParsing="false" onAction="#btnVoltarOnAction" text="Voltar ao menu" />
    </children>
</AnchorPane>
