<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TypeChartController">
    <children>
        <Label layoutX="214.0" layoutY="14.0" text="Tabela de tipos">
            <font>
                <Font size="32.0" />
            </font>
        </Label>

        <ImageView fx:id="imgTypeChart" fitHeight="340.0" fitWidth="550.0" layoutX="151.0" layoutY="80.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/type_chart.jpg" />
            </image>
        </ImageView>

        <Button layoutX="50.0" layoutY="440.0" mnemonicParsing="false" onAction="#btnVoltarOnAction" text="Voltar ao Menu" />
    </children>
</AnchorPane>
