<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Search.SearchAttackController">
   <children>
      <VBox layoutX="105.0" layoutY="110.0" prefHeight="170.0" prefWidth="390.0">
         <children>
            <HBox prefHeight="55.0" prefWidth="298.0">
               <children>
                  <Label fx:id="lblNomeAtaque" text="Nome do ataque:  ">
                     <padding><Insets bottom="10.0" left="10.0" top="10.0" /></padding>
                  </Label>
                  <TextField fx:id="txtNomeAtaque" prefHeight="38.0" prefWidth="187.0" />
                  <Button fx:id="btnBuscarAtaque" mnemonicParsing="false" onAction="#btnBuscarAtaqueAction" text="Buscar">
                     <HBox.margin><Insets left="10.0" top="5.0" /></HBox.margin>
                  </Button>
               </children>
            </HBox>
            <HBox prefHeight="55.0" prefWidth="308.0">
               <children>
                  <Label fx:id="lblIdAtaque" text="ID do ataque:  ">
                     <padding><Insets bottom="10.0" left="10.0" top="10.0" /></padding>
                  </Label>
                  <TextField fx:id="txtIdAtaque" prefHeight="38.0" prefWidth="187.0" />
                  <Button fx:id="btnBuscarIdAtaque" mnemonicParsing="false" onAction="#btnBuscarIdAtaqueAction" text="Buscar">
                     <HBox.margin><Insets left="10.0" top="5.0" /></HBox.margin>
                  </Button>
               </children>
            </HBox>
            <HBox prefHeight="55.0" prefWidth="298.0">
               <children>
                  <Label fx:id="lblTipoAtaque" text="Tipo do ataque:  ">
                     <padding><Insets bottom="10.0" left="10.0" top="10.0" /></padding>
                  </Label>
                  <TextField fx:id="txtTipoAtaque" prefHeight="38.0" prefWidth="187.0" />
                  <Button fx:id="btnBuscarTipoAtaque" mnemonicParsing="false" onAction="#btnBuscarTipoAtaqueAction" text="Buscar">
                     <HBox.margin><Insets left="10.0" top="5.0" /></HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
      <Label layoutX="147.0" layoutY="30.0" text="Pesquisar ataque">
         <font><Font size="40.0" /></font>
      </Label>
      <Button layoutX="105.0" layoutY="315.0" mnemonicParsing="false" onAction="#btnVoltarOnAction" text="Voltar ao menu" />
   </children>
</AnchorPane>
