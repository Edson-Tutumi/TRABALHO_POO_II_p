<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PokemonAttackController">
    <children>
        <Label layoutX="130.0" layoutY="20.0" text="Vincular ataques ao pokemon">
            <font><Font size="24.0" /></font>
        </Label>
        <VBox layoutX="100.0" layoutY="75.0" prefHeight="95.0" prefWidth="400.0" spacing="10.0">
            <children>
                <HBox spacing="10.0">
                    <children>
                        <Label prefWidth="120.0" text="ID do pokemon:">
                            <padding><Insets top="5.0" /></padding>
                        </Label>
                        <TextField fx:id="txtIdPokemon" prefWidth="250.0" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label prefWidth="120.0" text="ID do ataque:">
                            <padding><Insets top="5.0" /></padding>
                        </Label>
                        <TextField fx:id="txtIdAtaque" prefWidth="250.0" />
                    </children>
                </HBox>
                  <Button mnemonicParsing="false" onAction="#btnBuscarPokemonPorAtaqueOnAction" prefHeight="26.0" prefWidth="68.0" text="Buscar" />
            </children>
        </VBox>
        <VBox layoutX="100.0" layoutY="180.0" spacing="10.0">
            <children>
                <HBox spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#btnVincularOnAction" prefWidth="120.0" text="Vincular" />
                        <Button mnemonicParsing="false" onAction="#btnDesvincularOnAction" prefWidth="120.0" text="Desvincular" />
                        <Button mnemonicParsing="false" onAction="#btnListarAtaquesOnAction" prefWidth="120.0" text="Listar ataques" />
                    </children>
                </HBox>
                <Button mnemonicParsing="false" onAction="#btnVoltarOnAction" prefWidth="380.0" text="Voltar ao Menu" />
            </children>
        </VBox>
        <TextArea fx:id="txtAreaResultados" layoutX="100.0" layoutY="270.0" prefHeight="195.0" prefWidth="400.0" />
    </children>
</AnchorPane>
